{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "odb2mon",
  "version": "0.4.0",
  "identifier": "com.bangsmackpow.odb2mon",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "odb2mon - Vehicle Diagnostic Dashboard",
        "width": 1060,
        "height": 680,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
