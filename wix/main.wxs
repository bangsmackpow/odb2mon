<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='odb2mon'
        UpgradeCode='6E73B90B-5D34-453D-9D9B-053FA87E14A1'
        Manufacturer='odb2mon Contributors'
        Language='1033'
        Codepage='1252'
        Version='0.2.1'>

        <Package Id='*' Keywords='Installer' Description="odb2mon Vehicle Diagnostics Installer"
            Comments='Cross-Platform OBD2/UDS Diagnostics' Manufacturer='odb2mon Contributors'
            InstallerVersion='300' Languages='1033' Compressed='yes' SummaryCodepage='1252' Platform='x64' />

        <MajorUpgrade Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
        <Property Id='DiskPrompt' Value="odb2mon Installation [1]" />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='odb2mon'>
                    <Component Id='GuiExecutable' Guid='A1B2C3D4-E5F6-47A1-8901-23456789ABCD' Win64='yes'>
                        <File Id='odb2mon_app_exe' Name='odb2mon-app.exe' DiskId='1' Source='target\release\odb2mon-app.exe' KeyPath='yes'/>
                    </Component>
                    <Component Id='CliExecutable' Guid='8C757B3F-2621-4197-BF5C-CD78D00E26AA' Win64='yes'>
                        <File Id='obd_cli_exe' Name='obd-cli.exe' DiskId='1' Source='target\release\obd-cli.exe' KeyPath='yes'/>
                        <Environment Id="PATH" Name="PATH" Value="[APPLICATIONFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
                    </Component>
                    <Component Id='ReadmeFile' Guid='56C87C0F-87E7-4404-B475-A47E53B7BCF9' Win64='yes'>
                        <File Id='readme_md' Name='README.md' DiskId='1' Source='README.md' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature Id='Complete' Level='1'>
            <ComponentRef Id='GuiExecutable' />
            <ComponentRef Id='CliExecutable' />
            <ComponentRef Id='ReadmeFile' />
        </Feature>
    </Product>
</Wix>
